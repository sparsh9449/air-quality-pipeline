# Sensor.Community API
SENSOR_COMMUNITY_URL=https://data.sensor.community/static/v2/data.json
# Ontario bounding box: min_lon,min_lat,max_lon,max_lat
ONTARIO_BBOX=-95.16,41.67,-74.34,56.86
POLL_INTERVAL_SECONDS=300

# Redpanda / Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=aqi.measurements

# Storage
PARQUET_DIR=./data/parquet
DUCKDB_PATH=./data/aqi.duckdb
