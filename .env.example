# Source: global v2 bulk feed (last 5 minutes, worldwide)
SENSOR_BULK_URL=https://data.sensor.community/static/v2/data.json
# Optional dev/test override: set a bounding box (lat1,lon1,lat2,lon2) to use the
# box-filter endpoint instead of the global feed. Leave unset for the bulk feed.
# BBOX=43.4,-80.0,44.3,-78.9

# Required by the API: identify the client. Keep this a placeholder, no personal email.
USER_AGENT=air-quality-pipeline (github.com/<your-username>/air-quality-pipeline)

POLL_INTERVAL_SECONDS=300
RETENTION_DAYS=7
PARQUET_DIR=./data/parquet

# Streaming (phase 2): Redpanda broker address for producer/consumers.
REDPANDA_BROKER=localhost:9092
